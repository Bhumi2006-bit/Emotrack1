yarn-debug.log*
yarn-error.log*
.vite/

# Large Model Weights (>50MB - GitHub hard limit is 100MB)
# Fine-tuned PyTorch checkpoints are reproducible via backend/research/ scripts.
# Production inference uses Hugging Face automatic download/cache fallback or local lightweight models.
*.pt
*.pth
*.bin
*.safetensors
*.h5
*.onnx

# Explicitly ensure lightweight production models (<1MB) are preserved and tracked
!backend/evaluation/data/stress_model.pkl
!backend/evaluation/data/stress_tfidf_vectorizer.pkl

